      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: "https://weather.yastatic.net/s3/weather-frontend/front2/_next/static/media/ru_black.a7a69ab7.svg"
    expected-status: "[200,301,302]"
    interval: 180
    tolerance: 50
    lazy: true

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: "https://weather.yastatic.net/s3/weather-frontend/front2/_next/static/media/ru_black.a7a69ab7.svg"
    expected-status: "[200,301,302]"
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

