mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome

external-controller: 127.0.0.1:9090

# =========================
# 👁 SNIFFER
# =========================
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

# =========================
# 🧬 DNS (Только Яндекс)
# =========================
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
    - "*.ok.ru"
    - "*.ozon.ru"
    - "*.wildberries.ru"
    - "*.avito.ru"
  default-nameserver:
    - 77.88.8.8
    - 77.88.8.1
  nameserver:
    - 77.88.8.8
    - 77.88.8.1
  fallback:
    - 77.88.8.8
    - 77.88.8.1
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4

# =========================
# 🔥 ПОДПИСКИ (ВАРИАНТ 6: Проверенные параметры без мусора)
# =========================
proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://yandex.ru
      interval: 300
      timeout: 30000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          if (p['type'] === 'vless') {
            // Проверенные РАБОЧИЕ параметры (из варианта 1)
            p['fragment'] = {
              packets: 'tlshello',
              length: '100-200',
              interval: '1-5'
            };
            p['noises'] = [
              { type: 'rand', packet: '00', delay: '1-3' }
            ];
            p['flow'] = p['flow'] || 'xtls-rprx-vision';
            p['client-fingerprint'] = p['client-fingerprint'] || 'chrome';
          }
          return p;
        });
      }

  UNIVERSAL:
    type: http
    url: "https://raw.githubusercontent.com/zieng2/wl/refs/heads/main/vless_universal.txt"
    interval: 3600
    path: ./providers/universal.yaml
    health-check:
      enable: true
      url: http://yandex.ru
      interval: 300
      timeout: 30000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          if (p['type'] === 'vless') {
            p['fragment'] = {
              packets: 'tlshello',
              length: '100-200',
              interval: '1-5'
            };
            p['noises'] = [
              { type: 'rand', packet: '00', delay: '1-3' }
            ];
            p['flow'] = p['flow'] || 'xtls-rprx-vision';
            p['client-fingerprint'] = p['client-fingerprint'] || 'chrome';
          }
          return p;
        });
      }

# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:
  - name: AUTO
    type: url-test
    use:
      - MAIN
      - UNIVERSAL
    url: http://yandex.ru
    interval: 300
    tolerance: 150

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
    url: http://yandex.ru
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

# =========================
# 🌐 РУЛЫ
# =========================
