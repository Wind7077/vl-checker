proxy-groups:
  - name: AUTO
    type: url-test
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: http://ya.ru
    expected-status: "[200,301,302]"
    interval: 300
    tolerance: 50
    lazy: true

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: http://ya.ru
    expected-status: "[200,301,302]"
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

