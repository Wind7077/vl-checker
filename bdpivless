mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome # Глобальный JA3 отпечаток (ByeDPI метод)

external-controller: 127.0.0.1:9090

# =========================
# 👁 SNIFFER (Критически важно)
# =========================
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

# =========================
# 🧬 DNS (Полностью на Яндексе)
# =========================
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    # Белые списки РФ (чтобы приложения видели реальные IP)
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
    - "*.ok.ru"
    - "*.ozon.ru"
    - "*.wildberries.ru"
    - "*.avito.ru"
  default-nameserver:
    - 77.88.8.8
    - 77.88.8.1
  nameserver:
    - 77.88.8.8
    - 77.88.8.1
  fallback:
    - 77.88.8.8
    - 77.88.8.1
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4

# =========================
# 🔥 ПОДПИСКИ + BYEDPI/ZAPRET (JS Script)
# =========================
proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://yandex.ru
      interval: 300
      timeout: 5000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          p['fragment'] = {
            packets: 'tlshello',
            length: '10-20',
            interval: '10-20'
          };
          p['noises'] = [
            { type: 'rand', packet: '0123456789abcdef', delay: '10-20' },
            { type: 'str', packet: 'GET / HTTP/1.1\r\nHost: yandex.ru\r\n\r\n', delay: '5-10' }
          ];
          if (!p['client-fingerprint']) {
            p['client-fingerprint'] = 'chrome';
          }
          return p;
        });
      }

  UNIVERSAL:
    type: http
    url: "https://raw.githubusercontent.com/zieng2/wl/refs/heads/main/vless_universal.txt"
    interval: 3600
    path: ./providers/universal.yaml
    health-check:
      enable: true
      url: http://yandex.ru
      interval: 300
      timeout: 5000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          p['fragment'] = {
            packets: 'tlshello',
            length: '10-20',
            interval: '10-20'
          };
          p['noises'] = [
            { type: 'rand', packet: '0123456789abcdef', delay: '10-20' },
            { type: 'str', packet: 'GET / HTTP/1.1\r\nHost: yandex.ru\r\n\r\n', delay: '5-10' }
          ];
          if (!p['client-fingerprint']) {
            p['client-fingerprint'] = 'chrome';
          }
          return p;
        });
      }

# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:
  # Авто-выбор самого быстрого рабочего сервера среди ОБЕИХ подписок
  - name: AUTO
    type: url-test
    use:
      - MAIN
      - UNIVERSAL
    url: http://yandex.ru
    interval: 300
    tolerance: 50

  # Резерв если AUTO падает
  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
    url: http://yandex.ru
    interval: 300

  # Ручной выбор (показывает все ноды из обеих подписок + группы AUTO/FALLBACK)
  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

# =========================
# 🌐 РУЛЫ (TRAFFIC ROUTING)
# =========================
rules:
  # 1. Анти-петля (Loop Prevention) для Android VPN
  - PROCESS-NAME,com.follow.clash,DIRECT
  - PROCESS-NAME,com.greatfire.flclash,DIRECT
  - PROCESS-NAME,com.wireguard.android,DIRECT
  
  # 2. Локальные сети
