mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome

external-controller: 127.0.0.1:9090

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
    - "*.ok.ru"
    - "*.ozon.ru"
    - "*.wildberries.ru"
    - "*.avito.ru"
  default-nameserver:
    - 77.88.8.8
    - 77.88.8.1
  nameserver:
    - 77.88.8.8
    - 77.88.8.1
  fallback:
    - 77.88.8.8
    - 77.88.8.1
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4

proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://ya.ru
      expected-status: "[200,301,302]"
      interval: 300
      timeout: 15000
    script: |
      function main(proxies) {
        const profiles = [
          { tag: 'S', fp: 'chrome', frag: null },
          { tag: 'M', fp: 'chrome', frag: { packets: 'tlshello', length: '100-200', interval: '1-5' } },
          { tag: 'H', fp: 'firefox', frag: { packets: 'tlshello', length: '20-50', interval: '10-20' } }
        ];
        const out = [];
        for (const p of proxies) {
          for (const prof of profiles) {
            const clone = JSON.parse(JSON.stringify(p));
            clone['name'] = p['name'] + ' [' + prof.tag + ']';
            if (clone['type'] === 'vless') { clone['flow'] = clone['flow'] || 'xtls-rprx-vision'; }
            if (prof.frag) { clone['fragment'] = prof.frag; } else { delete clone['fragment']; }
            delete clone['noises'];
            if (prof.fp) { clone['client-fingerprint'] = prof.fp; } else { delete clone['client-fingerprint']; }
            out.push(clone);
          }
        }
        return out;
      }

