mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome # Глобальный JA3 (как в WINGSV)

external-controller: 127.0.0.1:9090

# =========================
# 👁 SNIFFER
# =========================
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

# =========================
# 🧬 DNS (Только Яндекс для локальных нужд)
# =========================
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
    - "*.ok.ru"
    - "*.ozon.ru"
    - "*.wildberries.ru"
    - "*.avito.ru"
  default-nameserver:
    - 77.88.8.8
    - 77.88.8.1
  nameserver:
    - 77.88.8.8
    - 77.88.8.1
  fallback:
    - 77.88.8.8
    - 77.88.8.1
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4

# =========================
# 🔥 ПОДПИСКИ (CLEAN XRAY MODE)
# =========================
proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204 # Стандарт для сортировки нод
      interval: 300
      timeout: 5000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          if (p['type'] === 'vless') {
            // 1. Чистый VLESS Reality (нативный метод Xray/WINGSV)
            p['flow'] = p['flow'] || 'xtls-rprx-vision';
            p['client-fingerprint'] = p['client-fingerprint'] || 'chrome';
            
            // 2. УДАЛЯЕМ агрессивные параметры, которые ломают серверы
            delete p['fragment'];
            delete p['noises'];
          }
          return p;
        });
      }

  UNIVERSAL:
    type: http
    url: "https://raw.githubusercontent.com/zieng2/wl/refs/heads/main/vless_universal.txt"
    interval: 3600
    path: ./providers/universal.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 300
      timeout: 5000
    script: |
      function main(proxies) {
        return proxies.map(p => {
          if (p['type'] === 'vless') {
            p['flow'] = p['flow'] || 'xtls-rprx-vision';
            p['client-fingerprint'] = p['client-fingerprint'] || 'chrome';
            delete p['fragment'];
            delete p['noises'];
          }
          return p;
        });
      }

# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:
  - name: AUTO
    type: url-test
    use:
      - MAIN
      - UNIVERSAL
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
    url: http://www.gstatic.com/generate_204
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

# =========================
# 🌐 РУЛЫ (TRAFFIC ROUTING)
# =========================
rules:
  # Анти-петля
  - PROCESS-NAME,com.follow.clash,DIRECT
  - PROCESS-NAME,com.greatfire.flclash,DIRECT
  - PROCESS-NAME,com.wireguard.android,DIRECT
  
  # Локальные сети
