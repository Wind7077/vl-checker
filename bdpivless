mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome # Глобальный JA3 (ByeDPI метод)

external-controller: 127.0.0.1:9090

# =========================
# 👁 SNIFFER
# =========================
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

# =========================
# 🧬 DNS
# =========================
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    # Исключаем белые списки из Fake-IP (чтобы приложения видели реальные IP)
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
  default-nameserver:
    - 8.8.8.8
    - 1.1.1.1
  nameserver:
    - https://cloudflare-dns.com/dns-query
    - https://dns.quad9.net/dns-query
  fallback:
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4
  respect-rules: true # DNS-запросы к заблокированным сайтам пойдут через PROXY

# =========================
# 🔥 ПОДПИСКА + BYEDPI/ZAPRET (JS Script)
# =========================
proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://yandex.ru # ✅ Тест через белый список
      interval: 300
      timeout: 5000
    
    # 🧬 JS-СКРИПТ: Внедряет fragment и noises в каждую ноду подписки
    script: |
      function main(proxies) {
        return proxies.map(p => {
          p['fragment'] = {
            packets: 'tlshello',
            length: '10-20',
            interval: '10-20'
          };
          p['noises'] = [
            { type: 'rand', packet: '0123456789abcdef', delay: '10-20' },
            { type: 'str', packet: 'GET / HTTP/1.1\r\nHost: yandex.ru\r\n\r\n', delay: '5-10' }
          ];
          if (!p['client-fingerprint']) {
            p['client-fingerprint'] = 'chrome';
          }
          return p;
        });
      }

# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:
  - name: AUTO
    type: url-test
    use:
      - MAIN
    url: http://yandex.ru 
    interval: 300
    tolerance: 50

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
    url: http://yandex.ru
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

# =========================
# 🌐 РУЛЫ (TRAFFIC ROUTING)
# =========================
rules:
  # 1. Анти-петля (Loop Prevention) для Android VPN
  - PROCESS-NAME,com.follow.clash,DIRECT 
  - PROCESS-NAME,com.greatfire.flclash,DIRECT
  - PROCESS-NAME,com.wireguard.android,DIRECT
  
  # 2. Локальные сети
  - IP-CIDR,192.168.0.0/16,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT
  - IP-CIDR,172.16.0.0/12,DIRECT
  
  # 3. Российские белые списки (Напрямую)
  - DOMAIN-SUFFIX,yandex.ru,DIRECT
  - DOMAIN-SUFFIX,ya.ru,DIRECT
  - DOMAIN-SUFFIX,mail.ru,DIRECT
  - DOMAIN-SUFFIX,vk.com,DIRECT
  - DOMAIN-SUFFIX,sberbank.ru,DIRECT
  - DOMAIN-SUFFIX,vtb.ru,DIRECT
  - DOMAIN-SUFFIX,gosuslugi.ru,DIRECT
  - DOMAIN-SUFFIX,ok.ru,DIRECT
  - DOMAIN-SUFFIX,ozon.ru,DIRECT
  - DOMAIN-SUFFIX,wildberries.ru,DIRECT
  - DOMAIN-SUFFIX,avito.ru,DIRECT
  - DOMAIN-SUFFIX,2gis.ru,DIRECT
  - DOMAIN-SUFFIX,yoomoney.ru,DIRECT
  - DOMAIN-SUFFIX,tinkoff.ru,DIRECT

  # 4. Зарубежный трафик (Через прокси)
  - DOMAIN-SUFFIX,google.com,PROXY
  - DOMAIN-SUFFIX,googleapis.com,PROXY
  - DOMAIN-SUFFIX,googlevideo.com,PROXY
  - DOMAIN-SUFFIX,youtube.com,PROXY
  - DOMAIN-SUFFIX,ytimg.com,PROXY
  - DOMAIN-SUFFIX,telegram.org,PROXY
  - DOMAIN-SUFFIX,t.me,PROXY
  - DOMAIN-SUFFIX,github.com,PROXY
  - DOMAIN-SUFFIX,githubusercontent.com,PROXY
  - DOMAIN-SUFFIX,instagram.com,PROXY
  - DOMAIN-SUFFIX,cdninstagram.com,PROXY
  - DOMAIN-SUFFIX,discord.com,PROXY
  - DOMAIN-SUFFIX,discord.gg,PROXY
  - DOMAIN-SUFFIX,whatsapp.com,PROXY
  - DOMAIN-SUFFIX,facebook.com,PROXY
  - DOMAIN-SUFFIX,twitter.com,PROXY
  - DOMAIN-SUFFIX,x.com,PROXY
  
  # 5. Финальный роут 
  # Все сайты, не указанные выше, пойдут через PROXY. 
  # Если хотите, чтобы неизвестные сайты шли напрямую, замените PROXY на DIRECT.
  - MATCH,PROXY
