mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
global-client-fingerprint: chrome

external-controller: 127.0.0.1:9090

# =========================
# 👁 SNIFFER
# =========================
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
    HTTP:

# =========================
# 🧬 DNS (Яндекс)
# =========================
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"
    - "dns.msftncsi.com"
    - "www.msftncsi.com"
    - "www.msftconnecttest.com"
    - "*.yandex.ru"
    - "*.ya.ru"
    - "*.yastatic.net" # Добавлено для корректной работы тестового файла
    - "*.mail.ru"
    - "*.vk.com"
    - "*.sberbank.ru"
    - "*.vtb.ru"
    - "*.gosuslugi.ru"
    - "*.tinkoff.ru"
    - "*.ok.ru"
    - "*.ozon.ru"
    - "*.wildberries.ru"
    - "*.avito.ru"
  default-nameserver:
    - 77.88.8.8
    - 77.88.8.1
  nameserver:
    - 77.88.8.8
    - 77.88.8.1
  fallback:
    - 77.88.8.8
    - 77.88.8.1
  fallback-filter:
    ipcidr:
      - 240.0.0.0/4

# =========================
# 🔥 ПОДПИСКИ + МУЛЬТИПРОФИЛЬНЫЙ ОБХОД DPI (WINGSV STYLE)
# =========================
# Каждая нода клонируется в 4 варианта:
# [L] Light: Мелкая фрагментация + Chrome JA3
# [M] Medium: Средняя фрагментация + Firefox JA3 + HTTP шум
# [H] Heavy: Агрессивная микро-фрагментация + Safari JA3 + множественные шумы
# [RAW] Clean: Без фрагментации (для Hysteria2/TUIC или если DPI спит)
# url-test сам оставит только те клоны, которые пробили DPI!

proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Wind7077/vl-checker/refs/heads/main/output/proxies_b64.txt"
    interval: 3600
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: "https://weather.yastatic.net/s3/weather-frontend/front2/_next/static/media/ru_black.a7a69ab7.svg" # ✅ Белый список + фиксированный размер
      expected-status: "[200,301,302]" # ✅ Требует реального скачивания файла
      interval: 600
      timeout: 15000 # Увеличено до 15с, так как скачивание через фрагментацию требует времени
    script: |
      function main(proxies) {
        const profiles = [
          { tag: 'L', fp: 'chrome', frag: { packets: 'tlshello', length: '10-20', interval: '10-20' },
            noises: [ { type: 'rand', packet: '0123456789abcdef', delay: '10-20' } ] },
          { tag: 'M', fp: 'firefox', frag: { packets: 'tlshello', length: '40-100', interval: '20-40' },
            noises: [
              { type: 'rand', packet: '0123456789abcdef0123456789abcdef', delay: '15-30' },
              { type: 'str', packet: 'GET / HTTP/1.1\r\nHost: yandex.ru\r\n\r\n', delay: '5-10' }
            ] },
          { tag: 'H', fp: 'safari', frag: { packets: 'tlshello', length: '1-10', interval: '1-10' },
            noises: [
              { type: 'rand', packet: '00112233445566778899aabbccddeeff', delay: '1-10' },
              { type: 'rand', packet: 'ffeeddccbbaa99887766554433221100', delay: '1-10' },
              { type: 'str', packet: 'GET / HTTP/1.1\r\nHost: yandex.ru\r\n\r\n', delay: '1-5' }
            ] },
          { tag: 'RAW', fp: null, frag: null, noises: null }
        ];
        const out = [];
        for (const p of proxies) {
          for (const prof of profiles) {
            const clone = JSON.parse(JSON.stringify(p));
            clone['name'] = p['name'] + ' [' + prof.tag + ']';
            if (prof.frag) { clone['fragment'] = prof.frag; } else { delete clone['fragment']; }
            if (prof.noises) { clone['noises'] = prof.noises; } else { delete clone['noises']; }
            if (prof.fp) { clone['client-fingerprint'] = prof.fp; } else { delete clone['client-fingerprint']; }
            out.push(clone);
          }
        }
        return out;
      }

