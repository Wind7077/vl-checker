# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:
  - name: AUTO
    type: url-test
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: "https://speed.cloudflare.com/__down?bytes=51200"
    interval: 180
    tolerance: 50
    lazy: true # тестировать активно только выбранную ноду, не молотить весь пул каждые 3 минуты

  - name: FALLBACK
    type: fallback
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    url: "https://speed.cloudflare.com/__down?bytes=51200"
    interval: 300

  - name: PROXY
    type: select
    use:
      - MAIN
      - UNIVERSAL
      - IGARECK-MOBILE
      - IGARECK-MOBILE-2
      - GFP-FREE
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

