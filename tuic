mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false

external-controller: 127.0.0.1:9090

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  nameserver:
    - 8.8.8.8
    - 1.1.1.1
  fallback:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
  fake-ip-filter:
    - "*.local"
    - "*.lan"
    - "ntp.*"
    - "time.*"

# =========================
# 🔥 ПОДПИСКА (AUTO UPDATE)
# =========================
proxy-providers:
  MAIN:
    type: http
    url: "https://raw.githubusercontent.com/Argh94/Proxy-List/refs/heads/main/Tuic.txt"
    interval: 3600   # 1 час автообновление
    path: ./providers/main.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 300

# =========================
# 🔀 ПРОКСИ ГРУППЫ
# =========================
proxy-groups:

  # авто выбор самого быстрого
  - name: AUTO
    type: url-test
    use:
      - MAIN
    url: http://www.gstatic.com/generate_204
    interval: 300

  # резерв если AUTO падает
  - name: FALLBACK
    type: fallback
    use:
      - MAIN
    url: http://www.gstatic.com/generate_204
    interval: 300

  # ручной выбор
  - name: PROXY
    type: select
    use:
      - MAIN
    proxies:
      - AUTO
      - FALLBACK
      - DIRECT

  # глобальный выход
  - name: GLOBAL
    type: select
    proxies:
      - PROXY
      - AUTO
      - DIRECT

# =========================
# 🌐 РУЛЫ (TRAFFIC ROUTING)
# =========================
rules:
  - DOMAIN-SUFFIX,google.com,PROXY
  - DOMAIN-SUFFIX,telegram.org,PROXY
  - DOMAIN-SUFFIX,youtube.com,PROXY
  - DOMAIN-SUFFIX,github.com,PROXY

  # локалка напрямую
  - IP-CIDR,192.168.0.0/16,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT

  # всё остальное
  - MATCH,GLOBAL
