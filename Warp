# --- Базовые настройки ядра (Mihomo/Clash.Meta) ---
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false # Глобальное отключение IPv6 для предотвращения утечек и обрывов на LTE/Wi-Fi
external-controller: 127.0.0.1:9090 # Необходимо для работы управления во FlClash

# --- Настройки DNS (Fake-IP) ---
# Нужны для корректной работы TUN-режима и обхода отравления DNS провайдером
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - localhost.ptlogin2.qq.com
    - dns.msftncsi.com
    - www.msftncsi.com
    - www.msftconnecttest.com
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

# --- Прокси-ноды ---
proxies:
  - name: "WARP"
    type: wireguard
    private-key: +CH1Ws1FQZDJocIHN05/xmjNVYQqQ7J+18WyqzE4QU8=
    server: 162.159.195.1
    port: 500
    ip: 172.16.0.2
    ipv6: 2606:4700:110:879e:bc38:897f:5e47:8e96 # Внутренний IPv6 самого туннеля WARP
    public-key: bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
    allowed-ips: ['0.0.0.0/0']
    reserved: [153, 176, 129]
    udp: true
    mtu: 1280
    keepalive: 25 # Добавлено: отправляет пульс каждые 25 сек, чтобы мобильный оператор не рвал NAT-сессию
    remote-dns-resolve: true
    dns: [8.8.8.8, 8.8.4.4, 2001:4860:4860::8888, 2001:4860:4860::8844]
    amnezia-wg-option:
      jc: 4
      jmin: 40
      jmax: 70
      s1: 0
      s2: 0
      h1: 1
      h2: 2
      h4: 3
      h3: 4
      i1: <b 0xc10000000101ec00002ed30c87a529ebb80adafffa8ea23dba93b7b43d42936e8490affd0529319f89a02a3ce2938129137278b1c263081b>

# --- Группы прокси ---
proxy-groups:
  - name: Cloudflare
    type: select
    icon: https://www.vectorlogo.zone/logos/cloudflare/cloudflare-icon.svg
    proxies:
      - WARP
    url: 'http://speed.cloudflare.com/'
    interval: 300

# --- Правила маршрутизации ---
rules:
  - MATCH,Cloudflare

# --- Виртуальная сетевая карта (TUN) для Android ---
tun:
  enable: true
  stack: mixed
  mtu: 1500 # MTU для самой системы Android
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
