mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false

external-controller: 127.0.0.1:9090

# ======================
# DNS (ВАЖНО: НЕ fake-ip)
# ======================
dns:
  enable: true
  ipv6: false
  enhanced-mode: redir-host
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
  fallback:
    - 1.0.0.1
    - 8.8.4.4
  fallback-filter:
    geoip: true

# ======================
# PROXY (WARP + AmneziaWG)
# ======================
proxies:
- name: "WARP"
  type: wireguard
  private-key: IOqV+8Tjbpy/PFzyzcZyes/mQLWibf82RCB/lr5o3G4=
  server: 162.159.195.1
  port: 500
  ip: 172.16.0.2
  public-key: bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
  allowed-ips:
    - 0.0.0.0/0
  reserved: [168, 18, 219]
  udp: true
  mtu: 1200

  amnezia-wg-option:
    jc: 2
    jmin: 20
    jmax: 40
    s1: 0
    s2: 0
    h1: 1
    h2: 2
    h3: 4
    h4: 3
    i1: <b 0xc40000000101fc00002e1d96f5f7ff3700e0c7bc7f608e25fb3d4e9bdaff26943f2101fb4383d3d15ea0c51584f1a280db3c70fd7956c7bb>

# ======================
# PROXY GROUPS
# ======================
proxy-groups:
- name: PROXY
  type: select
  proxies:
    - WARP

# ======================
# RULES (Telegram FIX)
