# --- Базовые настройки ядра (Mihomo/Clash.Meta) ---
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false # Глобальное отключение IPv6
external-controller: 127.0.0.1:9090

# --- Настройки DNS ---
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - localhost.ptlogin2.qq.com
    - dns.msftncsi.com
    - www.msftncsi.com
    - www.msftconnecttest.com
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

# --- Прокси-ноды ---
proxies:
  - name: "WARP"
    type: wireguard
    private-key: +CH1Ws1FQZDJocIHN05/xmjNVYQqQ7J+18WyqzE4QU8=
    server: 162.159.195.1
    port: 500
    ip: 172.16.0.2
    # ipv6: ... (Убрано, чтобы не было микро-задержек маршрутизации на LTE)
    public-key: bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
    allowed-ips: ['0.0.0.0/0']
    reserved: [153, 176, 129]
    udp: true
    mtu: 1280
    keepalive: 25 # Держит сессию живой
    remote-dns-resolve: false # ВАЖНО: Отключено. WARP сам отлично роутит DNS внутри туннеля, принудительный ресолв вызывал фризы.
    dns: [8.8.8.8, 1.1.1.1] # Убраны IPv6 адреса, оставлены только быстрые IPv4
    amnezia-wg-option:
      jc: 0      # ОТКЛЮЧЕНО для WARP. Мобильные операторы дропают junk-пакеты, что вызывало переподключение сессии (фриз на 2 сек).
      jmin: 40
      jmax: 70
      s1: 0      # ОТКЛЮЧЕНО
      s2: 0      # ОТКЛЮЧЕНО
      h1: 1
      h2: 2
      h4: 3
      h3: 4
      i1: "<b 0xc10000000101ec00002ed30c87a529ebb80adafffa8ea23dba93b7b43d42936e8490affd0529319f89a02a3ce2938129137278b1c263081b>"

# --- Группы прокси ---
proxy-groups:
  - name: Cloudflare
    type: select
    icon: https://www.vectorlogo.zone/logos/cloudflare/cloudflare-icon.svg
    proxies:
      - WARP
    url: 'http://cp.cloudflare.com/generate_204' # ЗАМЕНЕНО: Легковесный пинг (204 No Content) вместо тяжелого speedtest. Не вызывает обрывов при проверке.
    interval: 300

# --- Правила маршрутизации ---
rules:
  - MATCH,Cloudflare

# --- Виртуальная сетевая карта (TUN) для Android ---
tun:
  enable: true
  stack: mixed
  mtu: 1500
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
